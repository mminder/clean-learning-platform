  "components" : {
    "schemas" : {
      "ConsultationOfferingDetailResponse" : {
        "type" : "object",
        "properties" : {
          "cancellationDeadlineHours" : {
            "type" : "integer",
            "format" : "int32"
          },
          "eligibleExperts" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EligibleExpertResponse"
            }
          },
          "packages" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ConsultationPackageResponse"
            }
          },
          "sessionDurationMinutes" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "cancellationDeadlineHours", "eligibleExperts", "packages", "sessionDurationMinutes" ]
      },
      "ConsultationOfferingRequest" : {
        "type" : "object",
        "properties" : {
          "cancellationDeadlineHours" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          },
          "description" : {
            "type" : "string"
          },
          "eligibleExpertIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "name" : {
            "type" : "string",
            "minLength" : 1
          },
          "packages" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ConsultationPackageRequest"
            }
          },
          "sessionDurationMinutes" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0
          }
        },
        "required" : [ "cancellationDeadlineHours", "description", "eligibleExpertIds", "name", "packages", "sessionDurationMinutes" ]
      },
      "ConsultationOfferingResponse" : {
        "type" : "object",
        "properties" : {
          "cancellationDeadlineHours" : {
            "type" : "integer",
            "format" : "int32"
          },
          "description" : {
            "type" : "string"
          },
          "eligibleExpertIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "imageId" : {
            "type" : [ "string", "null" ],
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "packages" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ConsultationPackageResponse"
            }
          },
          "sessionDurationMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PUBLISHED", "ARCHIVED" ]
          }
        },
        "required" : [ "cancellationDeadlineHours", "description", "eligibleExpertIds", "id", "name", "packages", "sessionDurationMinutes", "status" ]
      },
      "ConsultationOfferingSummaryResponse" : {
        "type" : "object",
        "properties" : {
          "eligibleExpertCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "packageCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PUBLISHED", "ARCHIVED" ]
          }
        },
        "required" : [ "eligibleExpertCount", "id", "name", "packageCount", "status" ]
      },
      "ConsultationPackageRequest" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "price" : {
            "type" : "string",
            "pattern" : "\\d{1,8}(\\.\\d{1,2})?"
          },
          "sessionCount" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0
          }
        },
        "required" : [ "price", "sessionCount" ]
      },
      "ConsultationPackageResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "price" : {
            "$ref" : "#/components/schemas/MoneyResponse"
          },
          "sessionCount" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "id", "price", "sessionCount" ]
      },
