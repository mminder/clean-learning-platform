{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Clean Learning Platform API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/logout" : {
      "post" : {
        "operationId" : "logOut",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "tags" : [ "logout" ]
      }
    },
    "/api/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "me-controller" ]
      }
    },
    "/api/poc/login" : {
      "post" : {
        "operationId" : "logIn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PocLoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "poc-login-controller" ]
      }
    },
    "/api/poc/users" : {
      "get" : {
        "operationId" : "listUsers",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PocUserResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "poc-login-controller" ]
      }
    },
    "/api/shop/offerings" : {
      "get" : {
        "operationId" : "listOfferings",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ShopOfferingResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "shop-controller" ]
      }
    },
    "/api/shop/offerings/{id}" : {
      "get" : {
        "operationId" : "getOffering",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShopOfferingDetailResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "shop-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ConsultationOfferingDetailResponse" : {
        "type" : "object",
        "properties" : {
          "cancellationDeadlineHours" : {
            "type" : "integer",
            "format" : "int32"
          },
          "eligibleExperts" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EligibleExpertResponse"
            }
          },
          "packages" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ConsultationPackageResponse"
            }
          },
          "sessionDurationMinutes" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "cancellationDeadlineHours", "eligibleExperts", "packages", "sessionDurationMinutes" ]
      },
      "ConsultationPackageResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "price" : {
            "$ref" : "#/components/schemas/MoneyResponse"
          },
          "sessionCount" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "id", "price", "sessionCount" ]
      },
      "EligibleExpertResponse" : {
        "type" : "object",
        "properties" : {
          "bio" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "bio", "displayName", "id" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "CUSTOMER", "EXPERT", "ADMIN" ]
            }
          }
        },
        "required" : [ "email", "id", "name", "roles" ]
      },
      "MoneyResponse" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string"
          },
          "currency" : {
            "type" : "string"
          }
        },
        "required" : [ "amount", "currency" ]
      },
      "PocLoginRequest" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "userId" ]
      },
      "PocUserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "CUSTOMER", "EXPERT", "ADMIN" ]
            }
          }
        },
        "required" : [ "id", "name", "roles" ]
      },
      "ShopOfferingDetailResponse" : {
        "type" : "object",
        "properties" : {
          "consultation" : {
            "$ref" : "#/components/schemas/ConsultationOfferingDetailResponse"
          },
          "description" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "CONSULTATION" ]
          }
        },
        "required" : [ "consultation", "description", "id", "name", "type" ]
      },
      "ShopOfferingResponse" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "price" : {
            "$ref" : "#/components/schemas/MoneyResponse"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "CONSULTATION" ]
          }
        },
        "required" : [ "description", "id", "name", "price", "type" ]
      }
    }
  }
}
